digraph BookStoreZS {
  rankdir=TB;
  node [shape=box, style=rounded, fontsize=10];
	
	//Services (6)
	"Product Service"
	"Shopping Cart Service"
    "Order Service"
    "Payment Service"
    "Delivery Service"
    "Customer Service"    
    
	// Product Service connections (2)
    "Product Service" -> "Shopping Cart Service"
	"Product Service" -> "Order Service"
	
	// Shopping Cart Service connections (3)
	"Shopping Cart Service" -> "Product Service"
	"Shopping Cart Service" -> "Customer Service"
	"Shopping Cart Service" -> "Order Service"
	
	// Order Service connections (5)
	"Order Service" -> "Shopping Cart Service"
	"Order Service" -> "Customer Service"
	"Order Service" -> "Payment Service"
	"Order Service" -> "Delivery Service"
	"Order Service" -> "Product Service"

    // Payment Service connections (2)
	"Payment Service" -> "Order Service"
	"Payment Service" -> "Customer Service"
	
    // Delivery Service connections (2)
	"Delivery Service" -> "Order Service"
	"Delivery Service" -> "Customer Service"
	
	// Customer Service connections (4)
	"Customer Service" -> "Shopping Cart Service"
	"Customer Service" -> "Order Service"
	"Customer Service" -> "Payment Service"
	"Customer Service" -> "Delivery Service"	
}