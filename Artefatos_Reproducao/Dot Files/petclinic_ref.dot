digraph PetClinicRef {
    rankdir=TB;
  node [shape=box, style=rounded, fontsize=14];    
  
    // services (7)
    "API Gateway";
    "Config Server";
    "Discovery Server";
    "Customers Service";
    "Vets Service";
    "Visits Service";
    "Admin Server";

    // API Gateway connections (3)
    "API Gateway" -> "Customers Service";
    "API Gateway" -> "Vets Service";
    "API Gateway" -> "Visits Service";

    // Config Server connections (6)
    "Config Server" -> "API Gateway";
    "Config Server" -> "Customers Service";
    "Config Server" -> "Vets Service";
    "Config Server" -> "Visits Service";
    "Config Server" -> "Admin Server";
    "Config Server" -> "Discovery Server";

    // Discovery Server connections (6)
    "Discovery Server" -> "API Gateway";
    "Discovery Server" -> "Customers Service";
    "Discovery Server" -> "Vets Service";
    "Discovery Server" -> "Visits Service";
    "Discovery Server" -> "Admin Server";
    "Discovery Server" -> "Config Service";
    
    // Customers Service connections (2)
    "Customers Service" -> "Visits Service";
    "Customers Service" -> "API Gateway";

    // Vets Service connections (1)
    "Vets Service" -> "API Gateway";

    // Visits Service connections (2)
    "Visits Service" -> "Customers Service";
    "Visits Service" -> "API Gateway";    
    
    // Admin Server connections (6)
    "Admin Server" -> "API Gateway";
    "Admin Server" -> "Config Service";
    "Admin Server" -> "Discovery Server";
    "Admin Server" -> "Customers Service";
    "Admin Server" -> "Vets Service";
    "Admin Server" -> "Visits Service";
}