digraph PetClinicZS {
  rankdir=TB;
  node [shape=box, style=rounded, fontsize=14];

  // Services (8)
  "Gateway Service";
  "Config Service";
  "Discovery Service";
  "Client Service";
  "Vet Service";
  "Visit Service"; 
  "Admin Service";
  "Pet Service";

  // Gateway connections (7)
  "Gateway Service" -> "Client Service";
  "Gateway Service"-> "Pet Service";
  "Gateway Service" -> "Visit Service";
  "Gateway Service" -> "Vet Service";
  "Gateway Service" -> "Discovery Service";
  "Gateway Service" -> "Config Service";
  "Gateway Service" -> "Admin Service";

  // Config Service connections (7)
  "Config Service" -> "Client Service";
  "Config Service" -> "Pet Service";
  "Config Service" -> "Visit Service";
  "Config Service" -> "Vet Service";
  "Config Service" -> "Discovery Service";
  "Config Service" -> "Gateway Service";
  "Config Service" -> "Admin Service";
  
  // Discovery Service connections (7) 
  "Discovery Service" -> "Client Service";
  "Discovery Service" -> "Pet Service";
  "Discovery Service" -> "Visit Service";
  "Discovery Service" -> "Vet Service";
  "Discovery Service" -> "Config Service";
  "Config Service" -> "Gateway Service";
  "Config Service" -> "Admin Service";

  // Client Service connections (5)
  "Client Service" -> "Pet Service";
  "Client Service" -> "Discovery Service";
  "Client Service" -> "Config Service";
  "Client Service" -> "Gateway Service";
  "Client Service" -> "Admin Service";   
    
  // Vet Service connections (4)
  "Vet Service" -> "Discovery Service";
  "Vet Service" -> "Config Service";
  "Vet Service" -> "Gateway Service";
  "Vet Service" -> "Admin Service";   

  // Visit Service connections (5)
  "Visit Service" -> "Pet Service";
  "Visit Service" -> "Discovery Service";
  "Visit Service" -> "Config Service";
  "Visit Service" -> "Gateway Service";
  "Visit Service" -> "Admin Service";    

  // Admin Service connections (7)
  "Admin Service" -> "Client Service";
  "Admin Service" -> "Pet Service";
  "Admin Service" -> "Visit Service";
  "Admin Service" -> "Vet Service";
  "Admin Service" -> "Discovery Service";
  "Admin Service" -> "Config Service";
  "Admin Service" -> "Gateway Service";

  // Pet Service connections (6)
  "Pet Service" -> "Client Service";
  "Pet Service" -> "Visit Service";
  "Pet Service" -> "Discovery Service";  
  "Pet Service" -> "Config Service";
  "Pet Service" -> "Gateway Service";
  "Pet Service" -> "Admin Service";
}
